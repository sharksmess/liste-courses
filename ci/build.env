# Environnement de construction de la CI et de scripts/ci-build.sh (D-028).
# Valeurs INVENTEES, visiblement factices, versionnees : aucune n'ouvre quoi
# que ce soit. `next build` charge next.config.ts, qui valide l'environnement
# du serveur (apps/web/src/lib/env.ts) ; la construction n'ouvre aucune
# connexion a la base. URL sans mot de passe (gitleaks refuse les URL a
# identifiants).
APP_ENV=production
DATABASE_URL=postgresql://lc_app@localhost:5432/liste_courses_build
AUTH_DATABASE_URL=postgresql://lc_better_auth@localhost:5432/liste_courses_build
BETTER_AUTH_SECRET=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
BETTER_AUTH_URL=http://localhost:3200
