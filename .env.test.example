# Modele de .env.test.local (tranche 001, D-028). Aucune valeur reelle : chaque
# valeur ci-dessous DECRIT ce qu'il faut mettre. Copier en .env.test.local a la
# racine et remplacer chaque valeur. Aucune URL avec identifiants ici, meme
# factice : gitleaks les refuse a juste titre (pre-commit).

# --- Base de test (recreee a chaque lancement par tests/_factory/global-setup.ts)
# URL postgresql:// du superutilisateur local, base "postgres" ; sert aussi aux migrations.
TEST_DATABASE_ADMIN_URL=A_REMPLIR_url_superutilisateur_local_base_postgres
# Doit finir par _test (garde-fou contre la base de dev).
TEST_DATABASE_NAME=liste_courses_test
# Mots de passe poses sur les roles LOGIN apres migration, format role:motdepasse,role:motdepasse
# pour les roles lc_app et lc_better_auth. Roles communs au cluster : memes valeurs que la base de dev.
TEST_ROLE_PASSWORDS=A_REMPLIR_paires_role_motdepasse_pour_lc_app_et_lc_better_auth

# --- Test de catalogue de l'usine (tests/_factory/db-catalog.test.ts)
TEST_APP_SCHEMAS=lc,lc_auth
TEST_APP_ROLES=lc_owner,lc_app,lc_better_auth,lc_definer
TEST_RLS_EXEMPT_TABLES=

# --- Acces direct des tests sous le role applicatif (isolation, AC5)
# URL postgresql:// du role lc_app vers la base liste_courses_test.
TEST_DATABASE_URL_APP=A_REMPLIR_url_role_lc_app_base_liste_courses_test

# --- Serveur de test (port 3210, D-029 ; Signet utilise 3100)
TEST_APP_BASE_URL=http://localhost:3210

# --- Environnement du serveur de test : TEST_SERVER_ENV_FOO est transmis sous le nom FOO
# URL postgresql:// du role lc_app vers liste_courses_test (requetes applicatives).
TEST_SERVER_ENV_DATABASE_URL=A_REMPLIR_url_role_lc_app_base_liste_courses_test
# URL postgresql:// du role lc_better_auth vers liste_courses_test (better-auth seul).
TEST_SERVER_ENV_AUTH_DATABASE_URL=A_REMPLIR_url_role_lc_better_auth_base_liste_courses_test
# Etiquette a remplacer par 32 caracteres aleatoires au moins ; jamais vide, sinon env-check le croit facultatif (D-049).
TEST_SERVER_ENV_BETTER_AUTH_SECRET=A_REMPLIR_secret_aleatoire
TEST_SERVER_ENV_BETTER_AUTH_URL=http://localhost:3210
# Seule combinaison qui autorise AUTH_RATE_LIMIT=off (ADR-0003).
TEST_SERVER_ENV_APP_ENV=test
TEST_SERVER_ENV_AUTH_RATE_LIMIT=off
